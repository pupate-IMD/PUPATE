# The Pupate keeper's environment on the VPS. deploy/setup.sh copies this to /opt/pupate/app/.env
# (mode 600) with STATUS_DIR pointed at the web root. keeper/README.md explains every variable and
# its default; a line left empty here is simply not set.

# The chain: mainnet. For a Sepolia rehearsal, CHAIN_ID=11155111 and that deployment's addresses.
CHAIN_ID=1
RPC=
# The sending key, and the wallet that pays IMD for oracle reports. Empty: the keeper only simulates.
KEEPER_PRIVATE_KEY=

# The contracts, filled at launch (docs/deployment.md). Instead of these lines, ADDRESSES can name a
# JSON file with the fields of site/public/addresses.local.json (an absolute path: the keeper's
# working directory is keeper/).
TOKEN=
HOOK=
COCOON=
FEED=
FROM_BLOCK=
# Mainnet constants.
COLLECTION=0x0000eC93127BAA929E58E97dd0095A2BFb38ec1D
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395
POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
IMD=0xD34a99Bc0f67aE1bbd63C660e6d0b0dd03E263B7

# Reports come from the paid IMD oracle flow: 0.5 IMD each, one every six hours.
ATTESTATION_SOURCE=imd
# Listings come from OpenSea; without a key the keeper never buys.
LISTING_SOURCE=opensea
OPENSEA_API_KEY=

# The feeds, written straight into nginx's web root (setup.sh fills the domain in).
STATUS_DIR=/var/www/pupate.fun
# Seats shown on the Work page for scale, beside the vault's own.
WORK_SEATS=1,1477

LOOP_EVERY=15
GAS_PRICE_CAP_GWEI=30
