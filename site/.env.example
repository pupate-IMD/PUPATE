# The site's public variables, baked into the export at build time (README.md explains each).
# Locally: copy to .env.local. On the VPS: /etc/pupate/site.env, which deploy/update.sh loads.
NEXT_PUBLIC_CHAIN=mainnet
# WalletConnect project id from cloud.reown.com (free); injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=
# RPC endpoints for the live reads and the wallet transports; empty means the public endpoints.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_SEPOLIA=
